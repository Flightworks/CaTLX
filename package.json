{
  "name": "catlx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-catlx --only auth,firestore,hosting",
    "test:rules": "firebase emulators:exec --project demo-catlx --only auth,firestore \"vitest run --config vite.rules.config.ts tests/firestore --no-file-parallelism --hookTimeout 60000\"",
    "seed:firebase": "firebase emulators:exec --project demo-catlx --only auth,firestore \"node scripts/seed-firebase-emulator.mjs\"",
    "export:sqlite": "node scripts/export-sqlite.mjs",
    "validate:export": "node scripts/validate-import.mjs",
    "import:firebase": "node scripts/run-import-firestore.mjs"
  },
  "dependencies": {
    "@testing-library/react": "^16.3.0",
    "firebase": "^12.18.0",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.3",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^13.35.1",
    "jsdom": "^27.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.11"
  }
}

{
  "name": "catlx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-catlx --only auth,firestore,hosting",
    "test:rules": "firebase emulators:exec --project demo-catlx --only auth,firestore \"vitest run --config vite.rules.config.ts tests/firestore --no-file-parallelism\""
  },
  "dependencies": {
    "@testing-library/react": "^16.3.0",
    "firebase": "^12.18.0",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.3",
    "react-router-dom": "^7.9.4",
    "vitest": "^4.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^13.35.1",
    "jsdom": "^27.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.1.0"
  }
}
